{
  "name": "internal-tools-kit",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1.4.4",
  "scripts": {
    "dev": "bun --bun next dev",
    "build": "bun --bun next build",
    "start": "bun --bun next start",
    "lint": "bun --bun eslint .",
    "typecheck": "bun --bun next typegen && bun --bun tsc --noEmit",
    "test": "bun --conditions=react-server test tests/unit",
    "test:integration": "bun tests/integration.ts"
  },
  "dependencies": {
    "@libsql/client": "0.18.0",
    "lucide-react": "^0.468.0",
    "next": "16.4.5",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.39.0",
    "eslint-config-next": "16.4.5",
    "typescript": "~5.9.3"
  }
}
