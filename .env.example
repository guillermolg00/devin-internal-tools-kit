# Optional; the default is ./data/internal-tools.db. No env file is required.
# DATABASE_PATH=./data/internal-tools.db

# Fake login is disabled in production unless explicitly enabled for a demo.
# Never enable it on a real-data deployment, and only enable it publicly behind DEMO_PASSWORD.
# ENABLE_DEMO_AUTH=true

# Public demo deployment (Vercel). Leave unset for local development.
# DEMO_PASSWORD puts a shared-password gate in front of the whole app (pages and API).
# DEMO_PASSWORD=
# Use a remote libSQL/Turso database instead of the local SQLite file.
# TURSO_DATABASE_URL=libsql://<db>.turso.io
# TURSO_AUTH_TOKEN=
